# Required (local + Railway production)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
SECRET_KEY=generate-a-long-random-string
FLASK_ENV=development

# Required in production (Railway)
CORS_ORIGINS=https://your-frontend.netlify.app

# Optional — AI categorization
GEMINI_API_KEY=

# Password reset — local dev uses Brevo SMTP; Railway uses Brevo API (HTTPS)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-smtp-login@smtp-brevo.com
BREVO_SMTP_KEY=
BREVO_API_KEY=
EMAIL_TRANSPORT=api
SMTP_FROM=Budget Tracker <noreply@your-verified-domain.com>
APP_BASE_URL=https://your-frontend.netlify.app
